# Environment variables template for SS OIL Backend
PORT=5000
NODE_ENV=development

# Local SQLite Database
DATABASE_URL="file:./dev.db"

# Future TiDB Cloud Database
# DATABASE_URL="mysql://<user>:<password>@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/ssoil?sslaccept=strict"

CLIENT_URL="http://localhost:3000"
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"
RAZORPAY_KEY_ID="rzp_test_key"
RAZORPAY_KEY_SECRET="rzp_test_secret"
