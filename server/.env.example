# Server Configuration
PORT=5000
NODE_ENV=development

# Database URL (SQLite for instant zero-friction local development, easily changed to PostgreSQL / MySQL / TiDB)
DATABASE_URL="file:./dev.db"

# JWT Secret for Authentication
JWT_SECRET="ssoil-super-secret-jwt-key-2026-change-in-production"
JWT_EXPIRES_IN="7d"

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"

# Payment Gateway Keys (Mock / Razorpay)
RAZORPAY_KEY_ID="rzp_test_sample_key_123456"
RAZORPAY_KEY_SECRET="sample_secret_key_abcdef"
